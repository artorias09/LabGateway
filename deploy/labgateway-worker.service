[Unit]
Description=LabGateway Container Runner
After=docker.service
Requires=docker.service

[Service]
# Docker socket access is effectively host-root: never expose it to the web service.
User=labrunner
Group=labrunner
SupplementaryGroups=docker
WorkingDirectory=/opt/labgateway
Environment=LAB_DB=/var/lib/labgateway/labgateway.sqlite3
Environment=LAB_UPLOADS=/var/lib/labgateway/uploads
ExecStart=/opt/labgateway/.venv/bin/python worker.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
