[Unit]
Description=LabGateway Web
After=network.target

[Service]
User=labweb
Group=labweb
WorkingDirectory=/opt/labgateway
EnvironmentFile=/etc/labgateway/web.env
ExecStart=/opt/labgateway/.venv/bin/gunicorn -w 1 -b 127.0.0.1:5001 app:app
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/labgateway
PrivateTmp=true

[Install]
WantedBy=multi-user.target
